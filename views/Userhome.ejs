<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="/Stylesheets/Userhome.css">

    <title>Userhomepage</title>
</head>

<body>

    <body>

        <header class="header">

          <img src="/images/water_drop.jpeg" alt="Water Billing Logo">

            <h1>KSRP Water Bill Management System (UNOFFICIAL)</h1>

            <p>This is NOT an Official KSRP Website</p>

        </header>

        <div class="container">
            <div class="top-section">

                <div class="welcome-card">

                    <h2>Welcome Back 👋</h2>

                    <h1>
                        <%= user.name %>
                    </h1>

                    <p>
                        Block <%= user.block %>
                            •
                            Room <%= user.room %>
                    </p>

                </div>

                <div class="bill-card">

                    <div class="bill-header">

                        <h2>Current Bill</h2>

<span class="status
<%= latestBill &&
latestBill.status === "Paid"
? "paid"
: "unpaid" %>">

<%= latestBill ?
latestBill.status :
"No Bill" %>

</span>
                    </div>

                    <div class="amount">

                        ₹<%= latestBill ? latestBill.amount : 0 %>

                    </div>

                    <p>

                        <%= latestBill ? latestBill.month : "No Bill Available" %>

                    </p>

                    <a href="/mybill" class="view-btn">
    View Bill
</a>

                </div>
            </div>

            <div class="grid">

                <a href="/user_profile" class="card">
                    <div class="icon">👤</div>
                    <h3>Profile</h3>
                </a>

                <a href="/mybill" class="card">
                    <div class="icon">💧</div>
                    <h3>View Bill</h3>
                </a>

                <a href="/help" class="card">
                    <div class="icon">📞</div>
                    <h3>Help</h3>
                </a>

                <a href="/user/logout" class="card logout">
                    <div class="icon">🚪</div>
                    <h3>Logout</h3>
                </a>

            </div>

            <div class="notice">

                <h2>Important Notice</h2>

                <p>
                    Please pay your water bill before the due date to avoid penalties.
                </p>

            </div>

        </div>

    </body>

</html>