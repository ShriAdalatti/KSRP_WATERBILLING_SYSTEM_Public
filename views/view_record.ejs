<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link rel="stylesheet" href="/Stylesheets/view_record.css">

    <title>View Records</title>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
           <img src="/images/water_drop.jpeg" alt="Water Billing Logo">
                <h2>WaterBill</h2>
        </div>

        <ul>

            <li onclick="location.href='/admin_dashboard'"><i class="fas fa-home"></i>
                Dashboard
            </li>

            <li onclick="location.href='/manage_Users'">
                <i class="fas fa-users"></i>
                Manage Users
            </li>
            <li class="active" onclick="location.href='/view_record'">
                <i class="fas fa-database"></i>
                View Records
            </li>

            <li onclick="location.href='#'">
                <i class="fas fa-plus-circle"></i>
                Add Data
            </li>

            <li onclick="location.href='#'">
                <i class="fas fa-chart-bar"></i>
                Reports
            </li>

            <li onclick="location.href='/admin_settings'">
                <i class="fas fa-cog"></i>
                Settings
            </li>
            <li onclick="location.href='/'">
                <i class="fas fa-sign-out-alt"></i>
                Logout
            </li>

        </ul>

    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-wrap">

        <!-- TOP BAR -->
        <div class="topbar">

            <div class="topbar-title">
                <h1>Records</h1>
                <span>
                    Water Billing Management System <br><b>Administrative Portal </b></br>
                </span>
            </div>

            <div class="topbar-right">

                <input type="text" id="searchInput" placeholder="Search resident, block, room..."
                    onkeyup="searchUser()">

                <div class="admin-badge">
                    <div class="admin-avatar">A</div>
                    <span>Administrator</span>
                </div>

            </div>

        </div>

        <!-- PAGE HEADING -->
        <div class="page-heading">

            <div>
                <h2>Water Billing Records</h2>
                <p>
                    View and monitor all resident billing records
                </p>
            </div>

        </div>

        <!-- STATS -->
        <div class="stats-row">

            <div class="stat-card">
                <div class="sc-icon">📄</div>
                <div class="sc-label">Total Records</div>
                <div class="sc-val" id="totalRecords">0</div>
            </div>

            <div class="stat-card">
                <div class="sc-icon">✅</div>
                <div class="sc-label">Paid Bills</div>
                <div class="sc-val" id="paidBills">0</div>
            </div>

            <div class="stat-card">
                <div class="sc-icon">⚠️</div>
                <div class="sc-label">Unpaid Bills</div>
                <div class="sc-val" id="unpaidBills">0</div>
            </div>

            <div class="stat-card">
                <div class="sc-icon">₹</div>
                <div class="sc-label">Total Revenue</div>
                <div class="sc-val" id="totalRevenue">0</div>
            </div>

        </div>

        <!-- TABLE CARD -->
        <div class="table-card">

            <div class="table-card-head">
                <h3>Resident Billing Directory</h3>
                <span class="count-pill" id="recordCount">
                    Loading...
                </span>
            </div>

            <table id="viewrecord">

                <thead>
                    <tr>
                        <th>Sr No.</th>
                        <th>Bill ID</th>
                        <th>Name</th>
                        <th>Block</th>
                        <th>Room</th>
                        <th>Prev. Read</th>
                        <th>Curr.Read</th>
                        <th>Month</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody></tbody>

            </table>

        </div>

    </div>

    <script>

        /* Search */

        function searchUser() {

            const input =
                document.getElementById("searchInput")
                    .value.toLowerCase();

            const rows =
                document.querySelectorAll("#viewrecord tbody tr");

            let visible = 0;

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                if (text.includes(input)) {
                    row.style.display = "";
                    visible++;
                }
                else {
                    row.style.display = "none";
                }

            });

            document.getElementById("recordCount")
                .textContent =
                visible + " record" + (visible !== 1 ? "s" : "");

        }

        /* Load Bills */

        fetch("/admin/Bill")
            .then(res => res.json())
            .then(data => {

                let paid = 0;
                let unpaid = 0;
                let revenue = 0;

                document.getElementById("totalRecords")
                    .textContent = data.length;

                document.getElementById("recordCount")
                    .textContent =
                    data.length + " records";

                const tbody =
                    document.querySelector("#viewrecord tbody");

                data.forEach((user, index) => {

                    if (user.status &&
                        user.status.toLowerCase() === "paid")
                        paid++;
                    else
                        unpaid++;

                    revenue += Number(user.amount);

                    const badge =
                        (user.status &&
                            user.status.toLowerCase() === "paid")
                            ?
                            '<span class="paid-badge">Paid</span>'
                            :
                            '<span class="unpaid-badge">Unpaid</span>';

                    tbody.innerHTML += `

<tr>
    <td>${index + 1}</td>

<td>${user.billId || ("WB-" + user._id.toString().slice(-6).toUpperCase())}</td>

    <td>${user.name}</td>

    <td>${user.block}</td>

    <td>${user.room}</td>

    <td>${user.previousReading}</td>

    <td>${user.currentReading}</td>

    <td>${user.month}</td>

    <td>₹${user.amount}</td>

    <td>${badge}</td>

    <td>
        <button class="viewdetail">
            <i class="fa-solid fa-eye"></i> View
        </button>
    </td>
</tr>
</tr>

`;

                });

                document.getElementById("paidBills")
                    .textContent = paid;

                document.getElementById("unpaidBills")
                    .textContent = unpaid;

                document.getElementById("totalRevenue")
                    .textContent = "₹" + revenue;

            });

    </script>

</body>

</html>