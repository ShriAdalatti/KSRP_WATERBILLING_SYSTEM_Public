<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/Stylesheets/user_Profile.css">

    <title>UserProfile</title>
</head>
<body>
    <form action="/user_profile" method="post">
        <a href="/Userhome" class="bck-btn">Back</a>
         <h1>Profile Info</h1>
    <div class="profile">
      
       <p><b>Name :</b> <%=user.name %></p>
       <p><b>Block :</b><%=user.block%></p>
         <p><b>Room No: </b><%=user.room%></p>
       <p><b>Email :</b> <%=user.email %></p>
        <p><b>Meter No:</b><%=user.meterno%></p>
       <p><b>Mobile No:</b><%=user.phone%></p>
       <p><b>Payment Status:</b><%=user.status%></p>

    </div>

    </form>
    <footer><b>Disclaimer :</b> If You Want to change Your Personal Details Then , Please <b>Contact</b> the Admin.<br><b>ThankYou.</b></footer>
</body>
</html>