<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KSRP Water Bill - Admin Login</title>

<link rel="stylesheet" href="/Stylesheets/styleadmin.css">
    <link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

<!-- HEADER -->
<div class="navbox">

    <div class="header-content">

        <img src="/images/water_drop.jpeg" alt="Water Billing Logo">

        <div class="header-text">
            <h1>ADMIN LOGIN</h1>
            <p> (UNOFFICIAL) - Admin Portal</p>
        </div>
           <a href="/homepage" class="home-btn">
    <i class="fas fa-home"></i> Home
</a>
    </div>

</div>

<!-- LOGIN FORM -->
<form action="/adminlogin" method="post">

    <div class="login">

        <!-- LOGIN HEADER -->
        <div class="login-header">

            <div class="security-icon">
                🔐
            </div>

            <h2>Authorized Personnel Only</h2>

            <h3>Welcome Administrator</h3>

            <p>
                Please enter your credentials to access
                the Water Billing Management System.
            </p>

        </div>

        <!-- ADMIN ID -->
        <div class="information">
            <label for="admin_id">Admin ID:</label>

            <input
                type="text"
                id="admin_id"
                name="adminId"
                placeholder="Enter Admin ID"
                required
            >
        </div>

        <!-- PASSWORD -->
        <div class="information-password">
            <label for="password">Password:</label>

            <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter Password"
                minlength="8"
                required
            >
        </div>

        <!-- SHOW PASSWORD -->
        <div class="rowoption">

            <input
                type="checkbox"
                id="showPwd"
                onclick="togglePwd()"
            >

            <label for="showPwd">
                Show Password
            </label>

        </div>

        <!-- LOGIN BUTTON -->
        <div class="button">
            <button type="submit">
                Secure Login
            </button>
        </div>

        <!-- SECURITY NOTE -->
        <p class="security-note">
            🔒 This is a secure system.
            Unauthorized access is prohibited.
        </p>

    </div>

</form>

<!-- FOOTER -->
<p class="footer-text">
      © 2026 Water Billing Management System
</p>

<script>
    function togglePwd() {

        const pwd = document.getElementById("password");

        pwd.type =
            pwd.type === "password"
            ? "text"
            : "password";
    }
</script>
</body>
</html>
