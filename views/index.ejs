<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>KSRP WATERBILL</title>
    <link rel="stylesheet" href="/Stylesheets/style.css">
</head>

<body>
    <div class="head">
        <center>
            <h1 style="text-align:center;">3rd Battalion of the Karnataka State Reserve Police (KSRP)</h1>
        </center>
        <p style="text-align:center;">KSRP Block,Santhosapuram, Koramangala, Bengaluru, Karnataka 560034 </p>
    </div>
    <div class="top-bar"><a href="/Userhome" class="home-btn">Home</a></div>
    
<div class="main-container">

    <div class="Entry">
        <img src="https://imgs.search.brave.com/LUYijTGeMDDVK7GCPi_wOJUkWntRpqVE8-Y-kDLmXAo/rs:fit:500:0:1:0/g:ce/aHR0cHM6Ly9jaWdt/YS5pbi93cC1jb250/ZW50L3VwbG9hZHMv/MjAxNy8wNC9nb3Zl/cm5tZW50LW9mLWth/cm5hdGFrYS1sb2dv/LTcwMHg3MDAuanBn" alt="Karnataka Logo">
    </div>

    <form action="/getbill" method="POST">
        <div class="box">

            <div class="field">
                <label for="block">Block Name:</label>
                <input type="text" id="block" name="block" placeholder="Eg. BLOCK-A" required>
            </div>

            <div class="field">
                <label for="room">Room NO:</label>
                <input type="number" id="room" name="room" placeholder="Eg. 218" required>
            </div>

            <button type="submit">GET WATER BILL</button>

        </div>
    </form>
    

</div>
