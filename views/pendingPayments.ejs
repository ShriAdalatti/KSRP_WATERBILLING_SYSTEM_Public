<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Pending Payments</title>

<link rel="stylesheet"
href="/Stylesheets/pendingPayments.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
rel="stylesheet">

</head>

<body>

<div class="container">

    <div class="topbar">

        <div>

            <h1>
                Payment Verification Center
            </h1>

            <p>
                KSRP Water Bill Management System
            </p>

        </div>

        <a href="/admin_dashboard"
        class="back-btn">

            <i class="fas fa-arrow-left"></i>
            Dashboard

        </a>

    </div>

    <div class="summary-card">

        <h2>
            <%= bills.length %>
        </h2>

        <p>
            Pending Payment Requests
        </p>

    </div>

    <div class="payment-grid">

    <% bills.forEach(bill=>{ %>

        <div class="payment-card">

            <div class="card-header">

                <h3>
                    <%= bill.name %>
                </h3>

                <span class="pending-badge">

                    Pending

                </span>

            </div>

            <div class="details">

                <p>
                    <strong>Bill ID:</strong>
                    <%= bill.billId %>
                </p>

                <p>
                    <strong>Room:</strong>
                    <%= bill.room %>
                </p>

                <p>
                    <strong>Block:</strong>
                    <%= bill.block %>
                </p>

                <p>
                    <strong>Month:</strong>
                    <%= bill.month %>
                </p>

                <p>
                    <strong>Amount:</strong>
                    ₹<%= bill.amount %>
                </p>

            </div>

            <div class="actions">

                <form
                action="/admin/approve-payment/<%= bill._id %>"
                method="POST">

                    <button
                    class="approve-btn">

                        Approve

                    </button>

                </form>

                <form
                action="/admin/reject-payment/<%= bill._id %>"
                method="POST">

                    <button
                    class="reject-btn">

                        Reject

                    </button>

                </form>

            </div>

        </div>

    <% }) %>

    </div>

</div>

</body>
</html>