
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="Stylesheets/manage_Users.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <title>Manage Users — KSRP</title>
</head>
<body>

<!-- ══ SIDEBAR ══ -->
 <aside class="sidebar">

      <div class="logo">
        <img src="/images/water_drop.jpeg" alt="Water Billing Logo">
                <h2>WaterBill</h2>
      </div>

      <ul>

       <li onclick="location.href='/admin_dashboard'"><i class="fas fa-home"></i>
          Dashboard
        </li>

        <li class="active" onclick="location.href='/manage_Users'">
          <i class="fas fa-users"></i>
          Manage Users
        </li>
        <li onclick="location.href='/view_record'">
          <i class="fas fa-database"></i>
          View Records
        </li>

        <li onclick="location.href='#'">
          <i class="fas fa-plus-circle"></i>
          Add Data
        </li>

        <li onclick="location.href='#'">
          <i class="fas fa-chart-bar"></i>
          Reports
        </li>

<li onclick="location.href='/admin_settings'">
    <i class="fas fa-cog"></i>
    Settings
</li>

        <li onclick="location.href='/'">
          <i class="fas fa-sign-out-alt"></i>
          Logout
        </li>

      </ul>

    </aside>

<!-- ══ MAIN WRAP ══ -->
<div class="main-wrap">

  <!-- Top bar -->
  <div class="topbar">
    <div class="topbar-title">
      <h1>Manage Users</h1>
      <span>KSRP Water Billing Management System &nbsp;·&nbsp; Administrative Portal</span>
    </div>
    <div class="topbar-right">
      <div class="search-box">
        <input type="text"
               id="searchInput"
               placeholder="Search name, email, block or room…"
               onkeyup="searchUser()">
      </div>
      <div class="admin-badge">
        <div class="admin-avatar">A</div>
        <span>Administrator</span>
      </div>
    </div>
  </div>

  <!-- Page content -->
  <div class="page-content">

    <!-- Page heading -->
    <div class="page-heading">
      <div>
        <h2>Quarter Residents</h2>
        <p>Manage and monitor all registered quarter residents</p>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="sc-icon">👤</div>
        <div class="sc-label">Total Users</div>
        <div class="sc-val" id="totalUsers">—</div>
      </div>
      <div class="stat-card">
        <div class="sc-icon">🏢</div>
        <div class="sc-label">Active Blocks</div>
        <div class="sc-val">2</div>
      </div>
      <div class="stat-card">
        <div class="sc-icon">✅</div>
        <div class="sc-label">Active Residents</div>
        <div class="sc-val" id="activeCount">—</div>
      </div>
      <div class="stat-card">
        <div class="sc-icon">📋</div>
        <div class="sc-label">Total Records</div>
        <div class="sc-val" id="recordTotal">—</div>
      </div>
    </div>

    <!-- Table card -->
    <div class="table-card">
      <div class="table-card-head">
        <h3>Resident Directory</h3>
        <span class="count-pill" id="recordCount">Loading…</span>
      </div>

      <table id="userTable">
        <thead>
          <tr>
            <th>Sr.No</th>
            <th>Name</th>
            <th>Email</th>
            <th>Block</th>
            <th>Room</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>

  </div><!-- /page-content -->
</div><!-- /main-wrap -->

<!-- ══ DELETE MODAL ══ -->
<div id="confirmModal" class="modal">
  <div class="modal-content">
    <div class="modal-icon">🗑</div>
    <h3>Delete Resident</h3>
    <p>Are you sure you want to permanently remove this resident? This action cannot be undone.</p>
    <div class="modal-buttons">
      <button id="confirmBtn">Yes, Delete</button>
      <button onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>

<!-- ══ RESET PASSWORD MODAL ══ -->
<div id="passwordModal" class="modal">
  <div class="modal-content">
    <div class="modal-icon">🔑</div>
    <h3>Reset User Password</h3>

    <input
      type="password"
      id="newPassword"
      placeholder="Enter new password"
      style="width:100%;padding:10px;margin:10px 0;border:1px solid #ccc;border-radius:8px;"
    >

    <input
      type="password"
      id="confirmPassword"
      placeholder="Confirm password"
      style="width:100%;padding:10px;margin-bottom:15px;border:1px solid #ccc;border-radius:8px;"
    >

    <div class="modal-buttons">
      <button id="resetPasswordBtn">Reset Password</button>
      <button onclick="closePasswordModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
/* Search */
function searchUser() {
  const q = document.getElementById("searchInput").value.toLowerCase();
  const rows = document.querySelectorAll("#userTable tbody tr");
  let vis = 0;
  rows.forEach(r => {
    const show = r.innerText.toLowerCase().includes(q);
    r.style.display = show ? "" : "none";
    if (show) vis++;
  });
  document.getElementById("recordCount").textContent =
    vis + " record" + (vis !== 1 ? "s" : "");
}

/* Modal */
let deleteId = null, currentRow = null;
function openModal(id, btn) {
  deleteId = id;
  currentRow = btn.closest("tr");
  document.getElementById("confirmModal").style.display = "flex";
}
function closeModal() {
  document.getElementById("confirmModal").style.display = "none";
}
document.getElementById("confirmBtn").onclick = function () {
  fetch(`/admin/users/${deleteId}`, { method: "DELETE" })
    .then(res => res.text())
    .then(() => {
      if (currentRow) {
        currentRow.style.transition = "opacity .3s, transform .3s";
        currentRow.style.opacity = "0";
        currentRow.style.transform = "translateX(16px)";
        setTimeout(() => {
          currentRow.remove();
          const t = document.querySelectorAll("#userTable tbody tr").length;
          document.getElementById("totalUsers").textContent = t;
          document.getElementById("activeCount").textContent = t;
          document.getElementById("recordTotal").textContent = t;
          document.getElementById("recordCount").textContent =
            t + " record" + (t !== 1 ? "s" : "");
        }, 320);
      }
      closeModal();
    })
    .catch(err => console.log(err));
};

/* Load users */
fetch("/admin/users")
  .then(res => res.json())
  .then(data => {
    const n = data.length;
    document.getElementById("totalUsers").textContent   = n;
    document.getElementById("activeCount").textContent  = n;
    document.getElementById("recordTotal").textContent  = n;
    document.getElementById("recordCount").textContent  =
      n + " record" + (n !== 1 ? "s" : "");

    const tbody = document.querySelector("#userTable tbody");
    data.forEach((user, i) => {
      tbody.innerHTML += `
<tr>
  <td>${i + 1}</td>
  <td>${user.name}</td>
  <td>${user.email}</td>
  <td>${user.block}</td>
  <td>${user.room}</td>
  <td><span class="status occupied">Active</span></td>
  <td>
  <button class="editbtn"
    onclick="Edituser('${user._id}','${user.name}','${user.email}','${user.block}','${user.room}')">
    Edit
  </button>

  <button class="resetbtn"
    onclick="openPasswordModal('${user._id}')">
    Reset Password
  </button>

  <button class="deletebtn"
    onclick="openModal('${user._id}',this)">
    Delete
  </button>
</td>
</tr>`;
    });
  });

/* Edit */

let resetUserId = null;

function openPasswordModal(id) {
  resetUserId = id;

  document.getElementById("newPassword").value = "";
  document.getElementById("confirmPassword").value = "";

  document.getElementById("passwordModal").style.display = "flex";
}

function closePasswordModal() {
  document.getElementById("passwordModal").style.display = "none";
}


document.getElementById("resetPasswordBtn").onclick = function () {

  const password =
    document.getElementById("newPassword").value.trim();

  const confirm =
    document.getElementById("confirmPassword").value.trim();

  if (!password || !confirm) {
    alert("Please fill all fields.");
    return;
  }

  if (password !== confirm) {
    alert("Passwords do not match.");
    return;
  }

  if (password.length < 6) {
    alert("Password must be at least 6 characters.");
    return;
  }

  fetch(`/admin/users/reset-password/${resetUserId}`, {
    method: "PUT",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      password: password
    })
  })
  .then(res => res.text())
  .then(msg => {
    alert("Password reset successfully.");
    closePasswordModal();
  })
  .catch(err => {
    console.log(err);
    alert("Failed to reset password.");
  });
};



function Edituser(id, name, email, block, room) {
  const n = prompt("Enter new Name:", name);
  const e = prompt("Enter new Email:", email);
  const b = prompt("Enter new Block:", block);
  const r = prompt("Enter new Room:", room);
  if (!n || !e) return;
  fetch(`/admin/users/${id}`, {
    method: "PUT",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ name:n, email:e, block:b, room:r })
  })
  .then(res => res.text())
  .then(() => { alert("Resident updated successfully."); location.reload(); })
  .catch(err => console.log(err));
}
</script>
</body>
</html>