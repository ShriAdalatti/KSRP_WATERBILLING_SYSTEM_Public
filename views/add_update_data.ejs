<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Monthly Bill Upload</title>

<link rel="stylesheet"
href="/Stylesheets/add_update_data.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

<div class="container">

    <!-- HEADER -->

    <div class="top-bar">

        <div>
            <h1>
                KSRP Water Billing Management System
            </h1>

            <p>
                Monthly Bill Upload Module
            </p>
        </div>

        <button
        onclick="window.location.href='/admin_dashboard'"
        class="backbtn">

            ← Back

        </button>

    </div>

    <!-- UPLOAD SECTION -->

    <div class="upload-section">

        <h2>
            Upload Monthly Bill Sheet
        </h2>

        <div class="selectors">

            <select id="month">

                <option>January</option>
                <option>February</option>
                <option>March</option>
                <option>April</option>
                <option>May</option>
                <option>June</option>
                <option>July</option>
                <option>August</option>
                <option>September</option>
                <option>October</option>
                <option>November</option>
                <option>December</option>

            </select>

            <select id="year">

                <option>2025</option>
                <option selected>2026</option>
                <option>2027</option>

            </select>

        </div>

        <div class="upload-box">

            <i class="fa-solid fa-file-excel"></i>

            <h3>
                Upload Excel File
            </h3>

            <input
            type="file"
            id="excelFile"
            accept=".xlsx,.xls">

        </div>

        <div class="buttons">

            <button id="previewBtn">
                Preview Records
            </button>

            <button id="sampleBtn">
                Download Sample
            </button>

        </div>

    </div>

    <!-- VALIDATION -->

    <div class="summary-section">

        <h2>
            Validation Report
        </h2>

        <table>

            <tr>
                <td>Total Records</td>
                <td id="totalRecords">0</td>
            </tr>

            <tr>
                <td>Valid Records</td>
                <td id="validRecords">0</td>
            </tr>

            <tr>
                <td>Duplicate Records</td>
                <td id="duplicateRecords">0</td>
            </tr>

        </table>

    </div>

    <!-- PREVIEW -->

    <div class="preview-section">

        <h2>
            Preview Records
        </h2>

        <table id="previewTable">

            <thead>

                <tr>

                    <th>Name</th>
                    <th>Email</th>
                    <th>Block</th>
                    <th>Room</th>
                    <th>Prev.Reading</th>
                    <th>Curr.Reading</th>
                    <th>Amount</th>
                    <th>Month</th>
                    <th>Year</th>

                </tr>

            </thead>

            <tbody id="previewBody">

            </tbody>

        </table>

    </div>

    <!-- CONFIRM -->

    <div class="confirm-section">

        <button id="confirmUpload">

            Confirm Upload

        </button>

    </div>

    <!-- HISTORY -->

    <div class="history-section">

        <h2>

            Upload History

        </h2>

        <table>

            <thead>

                <tr>

                    <th>File</th>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Total</th>
                    <th>Date</th>

                </tr>

            </thead>

            <tbody id="historyBody">

            </tbody>

        </table>

    </div>

</div>

<script src="/Javascripts/add_update_data.js"></script>

</body>
</html>