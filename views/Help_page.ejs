<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Help & User Guide</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/Stylesheets/style_help_page.css">
</head>

<body>

<div class="wrapper">

    <!-- Header -->

    <header class="header">

        <div class="logo">

            <img src="/images/water_drop.jpeg" alt="Water Logo">

        </div>

        <div class="heading">

            <h1>Help & User Guide</h1>

            <p>Water Billing Management System</p>

            <span>
                Academic & Demonstration Project
            </span>

        </div>

    </header>

    <!-- Main Content -->

    <div class="container">

        <!-- Payment Guide -->

        <div class="card">

            <h2>
                <i class="fa-solid fa-droplet"></i>
                How to Pay Water Bill
            </h2>

            <ol>

                <li>
                    Go to the <b>Home Page</b>.
                </li>

                <li>
                    Click on <b>Pay Water Bill</b>.
                </li>

                <li>
                    Enter your <b>House Number</b> or
                    <b>Consumer ID</b>.
                </li>

                <li>
                    Verify your bill details.
                </li>

                <li>
                    Click <b>Pay Now</b>.
                </li>

                <li>

                    Choose your preferred payment method.

                    <ul>

                        <li>UPI</li>

                        <li>Debit / Credit Card</li>

                        <li>Net Banking</li>

                    </ul>

                </li>

                <li>

                    Download or print your payment receipt.

                </li>

            </ol>

        </div>

        <!-- Contact -->

        <div class="card">

            <h2>

                <i class="fa-solid fa-headset"></i>

                Contact Support

            </h2>

            <div class="info">

                <p>

                    <i class="fa-solid fa-building"></i>

                    <b>Office:</b>

                    3rd Battalion KSRP

                </p>

                <p>

                    <i class="fa-solid fa-location-dot"></i>

                    Ko***ala, Bengaluru – 5****4

                </p>

                <p>

                    <i class="fa-solid fa-phone"></i>

                    +91 XXXXX XXXXX

                </p>

                <p>

                    <i class="fa-solid fa-envelope"></i>

                    <a href="mailto:ksrpwaterbill@gmail.com">

                        ks********@gmail.com

                    </a>

                </p>

                <p>

                    <i class="fa-solid fa-clock"></i>

                    Monday – Friday

                    <br>

                    10:00 AM – 5:30 PM

                </p>

            </div>

        </div>

    </div>

    <!-- Tips -->

    <div class="tips">

        <h2>

            <i class="fa-solid fa-lightbulb"></i>

            Helpful Tips

        </h2>

        <ul>

            <li>✔ Always verify your bill before making payment.</li>

            <li>✔ Keep a copy of your payment receipt.</li>

            <li>✔ Contact the administrator if your bill details are incorrect.</li>

            <li>✔ Do not share your login credentials with anyone.</li>

        </ul>

    </div>

    <!-- Disclaimer -->

    <div class="disclaimer">

        <h3>

            <i class="fa-solid fa-circle-info"></i>

            Disclaimer

        </h3>

        <p>

            This is an academic software project developed by

            <b>Shrishail Adalatti</b>

            for educational, demonstration and portfolio purposes.

            The system was developed based on the operational

            requirements of the Karnataka State Reserve Police

            (KSRP) residential quarters.

        </p>

        <p>

            <b>

            This website is not affiliated with,

            endorsed by,

            or an official website of the Government of Karnataka

            or Karnataka State Reserve Police (KSRP).

            </b>

        </p>

    </div>

    <!-- Back Button -->

    <div class="back">

        <button onclick="window.location.href='/homepage'">

            <i class="fa-solid fa-house"></i>

            Back to Home

        </button>

    </div>

    <!-- Footer -->

    <footer>

        © 2026 Water Billing Management System

        <br>

        Academic & Demonstration Project

    </footer>

</div>

</body>

</html>