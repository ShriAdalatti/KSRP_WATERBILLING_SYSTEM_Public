<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">

    <link rel="stylesheet" href="/Stylesheets/style1.css">

    <title>KSRP WATERBILL</title>
</head>

<body>

    <div class="box">

        <div class="header-content">

            <img src="/images/water_drop.jpeg" alt="Water Billing Logo">

            <div class="title">

                <!-- Menu Button -->
                <div class="menu-container">

                    <button class="menu-btn" onclick="toggleMenu()">
                        ☰
                    </button>

                    <div class="nav-bar" id="navMenu">
                        <a href="#">Contact Us</a>
                        <a href="#">Complaint</a>
                        <a href="/help">Help</a>
                        <a href="/user_profile">Profile</a>
                    </div>

                </div>

                <h1>3rd Battalion of the Karnataka State Reserve Police (KSRP)</h1>

                <h3 style="color: rgb(241, 228, 227);">
                 <b>This is NOT an Official KSRP Website</b>
                </h3>
                


            </div>

        </div>

    </div>

    <div class="Login">

        <h3>🔐 Select Login Type</h3>

        <button class="admin"
            onclick="window.location.href='/Admin'">
            🛡️ Administrator Login
        </button>

        <button class="user"
            onclick="window.location.href='/Userlogin'">
            👤 User Login
        </button>

    </div>

    <div class="About">

        <h3>Disclaimer:</h3>

        <p>
            This is an academic software project developed by <b>Shrishail Adalatti</b> for demonstration<br>and portfolio purposes. It was designed based on the requirements of the<b> Karnataka State Reserve Police (KSRP)</b> residential quarters and is<br><b>not an official Government of Karnataka or KSRP website.</b>

        </p>

        <p>
            It aims to simplify billing, complaint registration, and support services through a user-friendly online system.
        </p>

       

    </div>



    <script>
        function toggleMenu() {
            document
                .getElementById("navMenu")
                .classList
                .toggle("show");
        }
    </script>

</body>

</html>