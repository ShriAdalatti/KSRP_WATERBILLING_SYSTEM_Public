<!DOCTYPE html>
<html>

<head>

<title>Pay Bill</title>

<link rel="stylesheet"
href="/Stylesheets/paybill.css">

</head>

<body>
<div class="payment-card">

    <div class="header">

        <h1>KSRP Water Bill Payment</h1>

        <p>Secure UPI Payment Portal</p>

    </div>

  <div class="bill-summary">

    <div class="summary-row">
        <span>Bill ID</span>
        <strong><%= bill.billId %></strong>
    </div>

    <div class="summary-row">
        <span>Name</span>
        <strong><%= bill.name %></strong>
    </div>

    <div class="summary-row">
        <span>Block</span>
        <strong><%= bill.block %></strong>
    </div>

    <div class="summary-row">
        <span>Room</span>
        <strong><%= bill.room %></strong>
    </div>

    <div class="summary-row">
        <span>Month</span>
        <strong><%= bill.month %></strong>
    </div>

</div>

<div class="amount-card">

    <p>Total Amount</p>

    <h1>
        ₹<%= bill.amount %>
    </h1>

</div>

<div class="qr-card">

    <h2>Scan To Pay</h2>

    <img src="<%= qrImage %>">

    <div class="upi-id">
        adalattishree1094-2@okaxis
    </div>

</div>

    <div class="buttons">

        <a href="/payment-submitted/<%= bill._id %>"
        class="submit-btn">

            I Have Paid
        </a>

        <a href="/mybill"
        class="back-btn">

            Back To Bill
        </a>

    </div>

</div>
</body>

</html>